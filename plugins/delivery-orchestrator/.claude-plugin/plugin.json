{
  "$schema": "https://claude.local/schemas/plugin.schema.json",
  "name": "delivery-orchestrator",
  "version": "1.0.0",
  "description": "Unified delivery orchestration: one plugin replacing six. A tested, dependency-free kernel (swarm conductor with leased claims and worktree isolation, guardrails, transactional state MCP, fleet protocol) behind platform adapters for Linear, Jira, GitHub and Harness. 133 commands, 156 agents, 52 skills, 12 schema-validated workflows, 155 tests.",
  "author": {
    "name": "Markus Ahling",
    "email": "markus@lobbi.io"
  },
  "license": "MIT",
  "repository": "https://github.com/markus41/claude",
  "keywords": [
    "orchestration",
    "delivery",
    "linear",
    "jira",
    "github",
    "harness",
    "swarm",
    "conductor",
    "agents",
    "agent-sessions",
    "pull-requests",
    "ci-cd",
    "release",
    "triage",
    "sprint",
    "guardrails",
    "two-way-sync",
    "mcp",
    "workflows",
    "dora"
  ],
  "permissions": {
    "requires": [
      "read",
      "write",
      "bash",
      "glob",
      "grep"
    ],
    "optional": [
      "agent",
      "mcp",
      "network"
    ]
  },
  "capabilities": {
    "provides": [
      "work.graph",
      "work.decomposition",
      "work.guardrails",
      "swarm.conductor",
      "review.adversarial",
      "ci.drive-to-green",
      "release.train",
      "rollback.planning",
      "tracker.linear",
      "tracker.jira",
      "tracker.github",
      "vcs.github",
      "vcs.harness",
      "cicd.harness",
      "insights.dora"
    ],
    "requires": []
  },
  "context": {
    "entry": "CONTEXT_SUMMARY.md",
    "title": "Delivery Orchestrator",
    "summary": "Unified delivery orchestration across Linear, Jira, GitHub and Harness. Tested kernel + platform adapters. 133 commands, 156 agents, 52 skills.",
    "tags": [
      "orchestration",
      "delivery",
      "linear",
      "jira",
      "github",
      "harness",
      "swarm"
    ],
    "bootstrapFiles": [
      "CONTEXT_SUMMARY.md"
    ],
    "maxTokens": 900,
    "excludeGlobs": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/*.zip",
      "**/*.tar*"
    ],
    "lazyLoadSections": [
      "CLAUDE.md",
      "README.md",
      "skills/*/SKILL.md",
      "commands/*.md",
      "agents/*.md",
      "lib/**/*.mjs",
      "tests/**/*.mjs",
      "docs/*.md",
      "workflows/*.json"
    ]
  },
  "contextEntry": "CONTEXT_SUMMARY.md"
}
