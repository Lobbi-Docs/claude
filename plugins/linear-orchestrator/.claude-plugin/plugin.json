{
  "$schema": "https://claude.local/schemas/plugin.schema.json",
  "name": "linear-orchestrator",
  "version": "2.0.0",
  "description": "Linear orchestration for Claude Code. Agent sessions and delegation, a Symphony-style swarm conductor that runs parallel workers in isolated git worktrees, and provider-neutral two-way sync with GitHub and Harness Code. Covers the GraphQL API, OAuth, webhooks, attachments, cycles, projects, initiatives, customers, SLA, triage, and Linear Diffs. 24 commands, 10 skills, 11 agents.",
  "author": {
    "name": "Markus Ahling",
    "email": "markus@lobbi.io"
  },
  "license": "MIT",
  "repository": "https://github.com/markus41/claude",
  "keywords": [
    "linear",
    "linear-app",
    "graphql",
    "oauth",
    "webhooks",
    "agents",
    "agent-sessions",
    "swarm",
    "orchestration",
    "conductor",
    "symphony",
    "github",
    "harness",
    "harness-code",
    "two-way-sync",
    "mcp",
    "cycles",
    "projects",
    "initiatives",
    "customer-requests",
    "sla",
    "triage",
    "diffs",
    "code-review",
    "issue-tracking",
    "automation"
  ],
  "permissions": {
    "requires": [
      "network:linear.app",
      "network:api.linear.app",
      "secrets:LINEAR_API_KEY",
      "secrets:LINEAR_OAUTH_CLIENT_SECRET",
      "secrets:LINEAR_WEBHOOK_SECRET"
    ],
    "optional": [
      "network:mcp.linear.app",
      "network:api.github.com",
      "secrets:GITHUB_TOKEN",
      "network:app.harness.io",
      "secrets:HARNESS_API_TOKEN",
      "secrets:HARNESS_ACCOUNT_ID"
    ]
  },
  "capabilities": {
    "provides": [
      "linear.issue.crud",
      "linear.cycle.management",
      "linear.project.management",
      "linear.initiative.management",
      "linear.customer.requests",
      "linear.sla.tracking",
      "linear.triage.workflow",
      "linear.webhook.handler",
      "linear.attachment.upload",
      "linear.agent.sessions",
      "linear.diffs.review",
      "linear.mcp.bridge",
      "swarm.conductor",
      "vcs.github.sync",
      "vcs.harness.sync"
    ],
    "requires": []
  },
  "context": {
    "entry": "CONTEXT_SUMMARY.md",
    "title": "Linear Orchestrator",
    "summary": "Linear orchestration: agent sessions, a parallel swarm conductor with isolated worktrees, and two-way sync with GitHub and Harness Code. 24 commands, 10 skills, 11 agents.",
    "tags": [
      "linear",
      "graphql",
      "agents",
      "swarm",
      "orchestration",
      "github",
      "harness",
      "two-way-sync",
      "mcp"
    ],
    "bootstrapFiles": [
      "CONTEXT_SUMMARY.md"
    ],
    "maxTokens": 800,
    "excludeGlobs": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/*.zip",
      "**/*.tar*"
    ],
    "lazyLoadSections": [
      "CLAUDE.md",
      "README.md",
      "skills/*/SKILL.md",
      "commands/*.md",
      "agents/*.md",
      "lib/**/*.mjs",
      "tests/**/*.mjs",
      "docs/*.md"
    ]
  },
  "contextEntry": "CONTEXT_SUMMARY.md"
}
